generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========== USER MANAGEMENT ==========

model User {
  id              String    @id @default(uuid()) @db.Uuid
  // Auth propio: las identidades viven en esta misma base. Cuando vivian en
  // Supabase, el proyecto desaparecio y se las llevo — ningun backup del
  // Postgres podia recuperarlas porque nunca estuvieron ahi.
  passwordHash    String? // scrypt; null si la cuenta solo entra con Google
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  // Se incrementa para invalidar de golpe todas las sesiones del usuario
  // (cambio de contrasena, baneo, sospecha de robo).
  tokenVersion    Int       @default(0)

  email           String    @unique
  username        String?   @unique // Login de administrador (solo admins)
  phone           String?   @unique
  name            String
  lastName        String
  documentType    String // cedula, pasaporte
  documentCountry String    @default("EC") // pais emisor del documento
  documentId      String?   @unique
  birthDate       DateTime?
  gender          String?

  // Avatar / Foto de perfil
  avatarUrl String?

  // Verificación
  identityVerified  Boolean   @default(false)
  selfieUrl         String?
  documentFrontUrl  String?
  documentBackUrl   String?
  verifiedAt        DateTime?
  verificationNotes String? // Rejection reason or admin notes
  verifiedBy        String?   @db.Uuid // Admin who verified/rejected

  // Billetera, en centavos. La invariante es: lo que la persona ve como saldo
  // es walletBalance, y heldBalance es lo retenido por reservas en curso, que
  // ya no puede gastar pero todavia no es de nadie mas.
  walletBalance  Int    @default(0) // disponible
  heldBalance    Int    @default(0) // retenido por reservas confirmadas
  walletCurrency String @default("USD") // USD en EC, DOP en RD

  // Suscripción
  subscriptionTier String    @default("free") // free, premium, elite
  subscriptionEnds DateTime?

  // Scoring (estilo Airbnb)
  rating     Float @default(0) // Promedio de reseñas recibidas (1-5)
  totalTrips Int   @default(0) // Viajes completados (dueño + inquilino)

  // Roles
  role String @default("user") // user, verifier, admin, superadmin

  // Pais de la cuenta. Las BD estan separadas por pais, pero el dato viaja
  // en backups, exportaciones y en la consola global de F8.
  countryCode String @default("EC") // EC, DO

  // Relaciones
  vehicles      Vehicle[]
  rentals       Booking[]      @relation("Renter")
  bookings      Booking[]      @relation("Tenant")
  reviews       Review[]
  documents     UserDocument[]
  messages      Message[]
  notifications Notification[]
  transactions  Transaction[]
  subscription  Subscription?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

// ========== BANNED IDENTITIES ==========

model BannedIdentity {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @unique // cédula vetada
  reason     String
  bannedBy   String?  @db.Uuid // userId que vetó (admin)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserDocument {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  type      String // license, insurance, soat, matricula
  url       String
  verified  Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

// ========== VEHICLE MANAGEMENT ==========

model Vehicle {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  // Identificación
  brand String
  model String
  year  Int
  plate String @unique
  color String
  vin   String @unique

  // Clasificación
  countryCode  String @default("EC") // EC, DO
  category     String // car, motorcycle, truck, van, suv, luxury
  seats        Int
  doors        Int?
  transmission String // manual, automatic
  fuelType     String // gasoline, diesel, electric, hybrid

  // Fotos
  photos String[]

  // Precios
  pricePerHour Int // centavos
  pricePerDay  Int // centavos
  pricePerKm   Int? // centavos
  deposit      Int    @default(0) // centavos
  currency     String @default("USD") // moneda de los precios de arriba

  // Disponibilidad
  available    Boolean @default(true)
  locationLat  Float?
  locationLng  Float?
  locationName String?

  // Features
  withDriver      Boolean @default(false)
  driverPrice     Int? // centavos
  flexibleCheckin Boolean @default(true)
  checkInTime     String? // HH:mm cuando flexibleCheckin=false
  checkOutTime    String? // HH:mm cuando flexibleCheckin=false

  // Estado
  mileage          Int       @default(0)
  lastMaintenance  DateTime?
  insurance        Boolean   @default(false)
  insuranceExpires DateTime?

  // Stats
  totalRentals Int   @default(0)
  rating       Float @default(0)

  // Metadata
  restrictions Json?
  features     String[]

  // Relaciones
  bookings      Booking[]
  conversations Conversation[]
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([category])
  @@index([available])
  @@index([countryCode])
}

// ========== BOOKING / RENTAL ==========

model Booking {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  tenantId  String  @db.Uuid
  tenant    User    @relation("Tenant", fields: [tenantId], references: [id])
  renterId  String? @db.Uuid
  renter    User?   @relation("Renter", fields: [renterId], references: [id])

  // Schedule
  startAt    DateTime
  endAt      DateTime
  returnedAt DateTime?

  // Driver
  withDriver Boolean @default(false)
  driverId   String? @db.Uuid

  // Pricing
  baseAmount   Int // centavos
  driverFee    Int    @default(0) // centavos
  insuranceFee Int    @default(0) // centavos
  serviceFee   Int // centavos
  totalAmount  Int // centavos
  currency     String @default("USD")
  deposit      Int // centavos

  // Insurance
  hasInsurance     Boolean @default(false)
  insuranceDetails Json?
  liabilityWaiver  Boolean @default(false)

  // Tracking
  trackingEnabled   Boolean         @default(false)
  trackingConsentAt DateTime? // consentimiento explicito del inquilino
  trackingPoints    TrackingPoint[]
  trackingData      Json?

  // Status
  status String @default("pending") // pending, confirmed, active, completed, cancelled, disputed

  // Fotos
  photosBefore String[]
  photosAfter  String[]

  // Damage
  damageReport Json?

  // Payment
  paymentStatus String  @default("pending") // pending, held, released, refunded
  transactionId String?

  conversations Conversation[]
  review        Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, status])
  @@index([tenantId])
  @@index([renterId])
  @@index([status, startAt])
}

// ========== REVIEWS ==========

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @db.Uuid
  booking   Booking  @relation(fields: [bookingId], references: [id])
  authorId  String   @db.Uuid
  author    User     @relation(fields: [authorId], references: [id])
  targetId  String   @db.Uuid
  vehicleId String?  @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  rating     Int
  comment    String?
  categories Json?

  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([vehicleId])
}

// ========== WALLET / TRANSACTIONS ==========

model Transaction {
  id                    String  @id @default(uuid()) @db.Uuid
  fromUserId            String? @db.Uuid
  toUserId              String? @db.Uuid
  user                  User?   @relation(fields: [toUserId], references: [id])
  bookingId             String? @db.Uuid
  type                  String // deposit, withdrawal, payment, refund, commission, subscription
  amount                Int // centavos
  currency              String  @default("USD")
  fee                   Int     @default(0) // centavos
  status                String  @default("pending") // pending, completed, failed, reversed
  description           String?
  referenceId           String?
  metadata              Json?
  stripePaymentIntentId String?

  createdAt DateTime @default(now())

  @@index([toUserId])
  @@index([fromUserId])
  @@index([bookingId])
  @@index([status, type])
}

// ========== SUBSCRIPTIONS ==========

model Subscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  tier      String // premium, elite
  price     Int // centavos
  currency  String   @default("USD")
  interval  String // monthly, yearly
  autoRenew Boolean  @default(true)
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("active") // active, cancelled, expired
  benefits  Json

  createdAt DateTime @default(now())
}

// ========== NOTIFICATIONS ==========

// ========== MESSAGING ==========

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  bookingId     String?   @unique @db.Uuid
  booking       Booking?  @relation(fields: [bookingId], references: [id])
  vehicleId     String?   @db.Uuid
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id])
  // IDs de los participantes (inquilino y dueño)
  userIds       String[]
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages Message[]
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @db.Uuid
  sender         User         @relation(fields: [senderId], references: [id])
  text           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  user     User    @relation(fields: [userId], references: [id])
  type     String
  title    String
  body     String?
  data     Json?
  read     Boolean @default(false)
  pushSent Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ========== AUDITORIA ==========
// Quien hizo que sobre usuarios, verificaciones, reservas y dinero.
// Incluye los accesos a trazas de ubicacion, que son dato personal sensible.
model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  actorId    String? @db.Uuid // admin que ejecuta la accion
  actorEmail String? // se guarda desnormalizado: el actor puede borrarse
  action     String // user.verify, user.ban, booking.refund, tracking.view...
  entityType String // User, Booking, Vehicle, TrackingPoint
  entityId   String? @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ========== RASTREO GPS ==========
// Sustituye al blob JSON Booking.trackingData, que se reescribia entero en
// cada punto (escrituras que se pisan) y crecia sin indice ni limite.
// Retencion: 90 dias. La ubicacion es dato personal sensible bajo la LOPDP
// ecuatoriana y la Ley 172-13 dominicana.
model TrackingPoint {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  lat        Float
  lng        Float
  speed      Float? // km/h
  heading    Float? // grados, 0-360
  accuracy   Float? // metros
  recordedAt DateTime // momento real de la lectura GPS, no el de llegada al servidor

  createdAt DateTime @default(now())

  @@index([bookingId, recordedAt])
}

// ========== SESIONES ==========
// Refresh token opaco y rotatorio. Se guarda solo el hash: si alguien lee la
// base, no se lleva sesiones utilizables.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Token de un solo uso para restablecer contrasena. Igual que arriba: se
// guarda el hash, nunca el token que viaja por correo.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}
