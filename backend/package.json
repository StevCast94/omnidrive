    "multer-storage-cloudinary": "^4.0.0",
    "prisma": "^6.5.0",
    "stripe": "^17.5.0",
    "tsx": "^4.19.0",
    "web-push": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
