# ============================================================
# backend/.env.example
# ============================================================

# PostgreSQL — Supabase (Transaction mode pooler recomendado)
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Supabase (mismo proyecto que la DB)
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...   # service_role — NUNCA expongas en frontend

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Web Push (VAPID) — generar con: npm run vapid:keys
VAPID_PUBLIC_KEY=BEl62iUY...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=admin@omnidrive.ec

# App
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://omnidrive.netlify.app

# ELIMINADAS (ya no necesarias con Supabase Auth):
# JWT_SECRET       → Supabase gestiona los tokens
# BCRYPT_ROUNDS    → Supabase gestiona las contraseñas


# ============================================================
# web/.env.example
# ============================================================

VITE_API_URL=https://omnidrive-api.railway.app/api

# Supabase — claves PÚBLICAS (anon key, segura para el frontend)
VITE_SUPABASE_URL=https://[REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...   # anon/public key

# Servicios externos
VITE_VAPID_PUBLIC_KEY=BEl62iUY...
VITE_MAPBOX_TOKEN=pk.eyJ1...
VITE_STRIPE_PK=pk_live_...

# ELIMINADAS:
# (ninguna — el token ya no se guarda en localStorage, vive en la sesión de Supabase)


# ============================================================
# Supabase: configuración recomendada del proyecto
# ============================================================
# Authentication → Settings:
#   - Enable email provider: ON
#   - Confirm email: OFF (MVP — activar en producción)
#   - Min password length: 8
#
# Authentication → URL Configuration:
#   - Site URL: https://omnidrive.netlify.app
#   - Redirect URLs: https://omnidrive.netlify.app/**
#
# Database → Connection Pooling:
#   - Mode: Transaction (para Railway serverless)
#   - Puerto: 6543
#
# IMPORTANTE: En schema.prisma agregar directUrl para migraciones:
#   datasource db {
#     provider  = "postgresql"
#     url       = env("DATABASE_URL")      // pooler (runtime)
#     directUrl = env("DIRECT_URL")        // directo (migraciones)
#   }


# ============================================================
# Generar claves VAPID
# ============================================================
# cd backend && npm run vapid:keys
# → Public Key → backend .env + VITE_VAPID_PUBLIC_KEY en web .env
# → Private Key → solo en backend .env
