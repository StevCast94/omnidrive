{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && npm ci --omit=dev && npx prisma generate && npx tsc; exit 0"
  },
  "deploy": {
    "startCommand": "bash entrypoint.sh",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
