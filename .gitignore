node_modules/
web/dist/
.env
*.log
.DS_Store
# backend/public/ tracks committed static assets (favicon, manifest, sw, icons)
# Vite build output (dist/*) is copied into backend/public/ by railway.json buildCommand
# Individual files in this dir are committed; generated files are ignored via web/dist/
# backend/public/

# Fotos temporales de la semilla (no son inventario real)
tmp-photos/

# backend/public es SALIDA DE BUILD: lo genera vite y lo copia railway.json.
# Tenerlo en git hacia que el index.html commiteado (apuntando a un bundle
# viejo) pisara al recien construido, y el sitio servia codigo antiguo.
backend/public/

# El worker de MapLibre se copia a public/assets en cada build/install
# (web/scripts/copiar-worker-mapa.mjs); no se commitea una copia de node_modules.
web/public/assets/
